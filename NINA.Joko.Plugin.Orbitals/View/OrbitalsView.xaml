<UserControl
    x:Class="NINA.Joko.Plugin.Orbitals.View.OrbitalsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
    xmlns:util="clr-namespace:NINA.Core.Utility;assembly=NINA.Core"
    xmlns:enums="clr-namespace:NINA.Joko.Plugin.Orbitals.Enums"
    xmlns:localvm="clr-namespace:NINA.Joko.Plugin.Orbitals.ViewModels"
    xmlns:alt="clr-namespace:NINA.WPF.Base.View;assembly=NINA.WPF.Base"
    xmlns:orules="clr-namespace:NINA.Joko.Plugin.Orbitals.ValidationRules"
    xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
    xmlns:oconverters="clr-namespace:NINA.Joko.Plugin.Orbitals.Converters"
    x:Name="UC"
    d:DataContext="{d:DesignInstance localvm:OrbitalsVM}"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Resources>
            <TextBlock x:Key="UpdateCometElements_Tooltip" Text="Downloads comet orbital elements from the selected source" />
            <TextBlock x:Key="CometAccessor_Tooltip">
                <Run Text="Where comet orbital elements are downloaded from:" /><LineBreak />
                <Run Text="  JPL - ~4,000 comets, but elements are often years out of date" /><LineBreak />
                <Run Text="  MPC - ~950 comets, refreshed within days of new observations" /><LineBreak />
                <Run Text="  Both - downloads both, keeps the newer elements for each comet (recommended)" /><LineBreak />
                <Run Text="Applies to comets only. Asteroid and JWST data always come from JPL." />
            </TextBlock>
            <TextBlock x:Key="ImportCometElements_Tooltip">
                <Run Text="Load comet elements from a file instead of downloading." /><LineBreak />
                <Run Text="Use this if your network cannot reach MPC or JPL (some VPN and hosting IPs are blocked)." /><LineBreak />
                <Run Text="Accepted files, downloadable on any other machine:" /><LineBreak />
                <Run Text="  MPC:  minorplanetcenter.net/iau/MPCORB/CometEls.txt" /><LineBreak />
                <Run Text="  JPL:  ssd.jpl.nasa.gov/dat/ELEMENTS.COMET" />
            </TextBlock>
            <TextBlock x:Key="ImportNumberedAsteroidElements_Tooltip">
                <Run Text="Load numbered asteroid elements from a file instead of downloading." /><LineBreak />
                <Run Text="Accepted file: ssd.jpl.nasa.gov/dat/ELEMENTS.NUMBR.gz (gzipped or extracted)" />
            </TextBlock>
            <TextBlock x:Key="ImportUnnumberedAsteroidElements_Tooltip">
                <Run Text="Load un-numbered asteroid elements from a file instead of downloading." /><LineBreak />
                <Run Text="Accepted file: ssd.jpl.nasa.gov/dat/ELEMENTS.UNNUM.gz (gzipped or extracted)" />
            </TextBlock>
            <TextBlock x:Key="ElementSource_Tooltip" Text="Which dataset these orbital elements came from, and the epoch they were computed for" />
            <TextBlock x:Key="UpdateNumberedAsteroidElements_Tooltip" Text="Updates numbered asteroid orbital elements" />
            <TextBlock x:Key="UpdateUnnumberedAsteroidElements_Tooltip" Text="Updates un-numbered asteroid orbital elements" />
            <TextBlock x:Key="UpdateJWSTVectorTable_Tooltip" Text="Updates James-Webb Telescope vector table, which is valid for 1 week" />
            <Style x:Key="ShowSolarSystemBody" TargetType="{x:Type Border}">
                <Setter Property="FrameworkElement.Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=PART_SearchObjectTypeEnumList, Path=SelectedItem}" Value="0">
                        <Setter Property="FrameworkElement.Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ShowOrbital" TargetType="{x:Type Border}">
                <Setter Property="FrameworkElement.Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=PART_SearchObjectTypeEnumList, Path=SelectedItem}" Value="1">
                        <Setter Property="FrameworkElement.Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ElementName=PART_SearchObjectTypeEnumList, Path=SelectedItem}" Value="2">
                        <Setter Property="FrameworkElement.Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ElementName=PART_SearchObjectTypeEnumList, Path=SelectedItem}" Value="3">
                        <Setter Property="FrameworkElement.Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ShowManualTLE" TargetType="{x:Type Border}">
                <Setter Property="FrameworkElement.Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=PART_SearchObjectTypeEnumList, Path=SelectedItem}" Value="5">
                        <Setter Property="FrameworkElement.Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ScrollViewer.Resources>
        <Grid Margin="5">
            <Grid.Resources>
                <util:BindingProxy x:Key="nighttimeProxy" Data="{Binding NighttimeData}" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <!--  Update Elements  -->
                <RowDefinition Height="Auto" />

                <!--  Search Bar -->
                <RowDefinition Height="Auto" />

                <!--  Orbital Refresh -->
                <RowDefinition Height="Auto" />

                <!--  Altitude Chart -->
                <RowDefinition Height="Auto" />

                <!--  Properties  -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Update Elements -->
            <GroupBox Grid.Row="0" Grid.Column="0" Header="Orbital Elements">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <!-- Comet source selector -->
                        <RowDefinition Height="Auto" />

                        <!-- Comets -->
                        <RowDefinition Height="Auto" />

                        <!-- Comet feed failure badge -->
                        <RowDefinition Height="Auto" />

                        <!-- Numbered Asteroids -->
                        <RowDefinition Height="Auto" />

                        <!-- Unnumbered Asteroids -->
                        <RowDefinition Height="Auto" />

                        <!-- JWST -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Type -->
                        <ColumnDefinition Width="Auto" />

                        <!-- Update Button -->
                        <ColumnDefinition Width="Auto" />

                        <!-- Import Button -->
                        <ColumnDefinition Width="Auto" />

                        <!-- Clear Button -->
                        <ColumnDefinition Width="Auto" />

                        <!-- Last Updated -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Comet source. Governs the comet Update button only; both asteroid
                         feeds and the JWST vector table are JPL-only, so the scope is
                         stated inline rather than left to be discovered. -->
                    <StackPanel
                        Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                        Margin="5,5,5,10"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Comet source: "
                            ToolTip="{StaticResource CometAccessor_Tooltip}" />
                        <ComboBox
                            Name="PART_CometAccessorEnumList"
                            MinWidth="80"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="{StaticResource CometAccessor_Tooltip}"
                            ItemsSource="{Binding Source={util:EnumBindingSource {x:Type enums:OrbitalElementsAccessorEnum}}}"
                            SelectedItem="{Binding Options.CometAccessor}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource O_EnumStaticDescriptionValueConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.7"
                            Text="Asteroids and JWST always come from JPL" />
                    </StackPanel>

                    <!-- Comets -->
                    <TextBlock
                        Grid.Row="1" Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        ToolTip="{Binding CometSourceBreakdown, Mode=OneWay}">
                        <Run Text="Comets (" /><Run Text="{Binding CometCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                    <ninactrl:CancellableButton
                        Grid.Row="1" Grid.Column="1"
                        Margin="5"
                        Height="30"
                        Padding="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ButtonText="Update"
                        CancelButtonImage="{StaticResource CancelSVG}"
                        CancelCommand="{Binding CancelUpdateCometElementsCommand}"
                        CancelToolTip="{ns:Loc LblCancel}"
                        Command="{Binding UpdateCometElementsCommand}"
                        ToolTip="{StaticResource UpdateCometElements_Tooltip}" />
                    <Button
                        Grid.Row="1" Grid.Column="2"
                        Margin="0,5,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding ImportCometElementsCommand}"
                        ToolTip="{StaticResource ImportCometElements_Tooltip}">
                        <TextBlock
                            Margin="10,5,10,5"
                            Foreground="{StaticResource ButtonForegroundBrush}"
                            Text="Import..."
                            TextWrapping="Wrap" />
                    </Button>
                    <Button
                        Grid.Row="1" Grid.Column="3"
                        Margin="5,5,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding ClearCometElementsCommand}">
                        <TextBlock
                            Margin="10,5,10,5"
                            Foreground="{StaticResource ButtonForegroundBrush}"
                            Text="Clear"
                            TextWrapping="Wrap" />
                    </Button>
                    <TextBlock
                        Grid.Row="1" Grid.Column="4"
                        Margin="10,5,5,5"
                        VerticalAlignment="Center">
                        <Run Text="Last Updated: " /><Run Text="{Binding CometLastUpdated, Mode=OneWay, Converter={StaticResource O_DateTimeMinToNeverConverter}}" />
                    </TextBlock>

                    <!-- Shown when a comet feed could not be downloaded. Sits directly under
                         the comet row because the failure is comet-specific, and points the
                         user at the Import button in the row above. Persistent rather than
                         toast-only, so a user who missed the notification still finds it. -->
                    <StackPanel
                        Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                        Margin="5,0,5,4"
                        Orientation="Horizontal"
                        Visibility="{Binding CometFeedFailed, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                        <Border
                            Width="16" Height="16"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource NotificationWarningBrush}"
                            BorderBrush="Transparent"
                            CornerRadius="8">
                            <Path
                                Data="{StaticResource ExclamationCircledSVG}"
                                Fill="{StaticResource ButtonForegroundBrush}"
                                Stretch="Uniform" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Text="{Binding CometFeedFailureMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Numbered Asteroids -->
                    <TextBlock
                        Grid.Row="3" Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="Numbered Asteroids (" /><Run Text="{Binding NumberedAsteroidCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                    <ninactrl:CancellableButton
                        Grid.Row="3" Grid.Column="1"
                        Margin="5"
                        Height="30"
                        Padding="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ButtonText="Update"
                        CancelButtonImage="{StaticResource CancelSVG}"
                        CancelCommand="{Binding CancelUpdateNumberedAsteroidElementsCommand}"
                        CancelToolTip="{ns:Loc LblCancel}"
                        Command="{Binding UpdateNumberedAsteroidElementsCommand}"
                        ToolTip="{StaticResource UpdateNumberedAsteroidElements_Tooltip}" />
                    <Button
                        Grid.Row="3" Grid.Column="2"
                        Margin="0,5,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding ImportNumberedAsteroidElementsCommand}"
                        ToolTip="{StaticResource ImportNumberedAsteroidElements_Tooltip}">
                        <TextBlock
                            Margin="10,5,10,5"
                            Foreground="{StaticResource ButtonForegroundBrush}"
                            Text="Import..."
                            TextWrapping="Wrap" />
                    </Button>
                    <Button
                        Grid.Row="3" Grid.Column="3"
                        Margin="5,5,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding ClearNumberedAsteroidElementsCommand}">
                        <TextBlock
                            Margin="10,5,10,5"
                            Foreground="{StaticResource ButtonForegroundBrush}"
                            Text="Clear"
                            TextWrapping="Wrap" />
                    </Button>
                    <TextBlock
                        Grid.Row="3" Grid.Column="4"
                        Margin="10,5,5,5"
                        VerticalAlignment="Center">
                        <Run Text="Last Updated: " /><Run Text="{Binding NumberedAsteroidLastUpdated, Mode=OneWay, Converter={StaticResource O_DateTimeMinToNeverConverter}}" />
                    </TextBlock>

                    <!-- Unnumbered Asteroids -->
                    <TextBlock
                        Grid.Row="4" Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="Un-numbered Asteroids (" /><Run Text="{Binding UnnumberedAsteroidCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                    <ninactrl:CancellableButton
                        Grid.Row="4" Grid.Column="1"
                        Margin="5"
                        Height="30"
                        Padding="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ButtonText="Update"
                        CancelButtonImage="{StaticResource CancelSVG}"
                        CancelCommand="{Binding CancelUpdateUnnumberedAsteroidElementsCommand}"
                        CancelToolTip="{ns:Loc LblCancel}"
                        Command="{Binding UpdateUnnumberedAsteroidElementsCommand}"
                        ToolTip="{StaticResource UpdateUnnumberedAsteroidElements_Tooltip}" />
                    <Button
                        Grid.Row="4" Grid.Column="2"
                        Margin="0,5,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding ImportUnnumberedAsteroidElementsCommand}"
                        ToolTip="{StaticResource ImportUnnumberedAsteroidElements_Tooltip}">
                        <TextBlock
                            Margin="10,5,10,5"
                            Foreground="{StaticResource ButtonForegroundBrush}"
                            Text="Import..."
                            TextWrapping="Wrap" />
                    </Button>
                    <Button
                        Grid.Row="4" Grid.Column="3"
                        Margin="5,5,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding ClearUnnumberedAsteroidElementsCommand}">
                        <TextBlock
                            Margin="10,5,10,5"
                            Foreground="{StaticResource ButtonForegroundBrush}"
                            Text="Clear"
                            TextWrapping="Wrap" />
                    </Button>
                    <TextBlock
                        Grid.Row="4" Grid.Column="4"
                        Margin="10,5,5,5"
                        VerticalAlignment="Center">
                        <Run Text="Last Updated: " /><Run Text="{Binding UnnumberedAsteroidLastUpdated, Mode=OneWay, Converter={StaticResource O_DateTimeMinToNeverConverter}}" />
                    </TextBlock>

                    <!-- JWST -->
                    <TextBlock
                        Grid.Row="5" Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="James-Webb Space Telescope" />
                    </TextBlock>
                    <ninactrl:CancellableButton
                        Grid.Row="5" Grid.Column="1"
                        Margin="5"
                        Height="30"
                        Padding="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ButtonText="Update"
                        CancelButtonImage="{StaticResource CancelSVG}"
                        CancelCommand="{Binding CancelUpdateJWSTVectorTableCommand}"
                        CancelToolTip="{ns:Loc LblCancel}"
                        Command="{Binding UpdateJWSTVectorTableCommand}"
                        ToolTip="{StaticResource UpdateJWSTVectorTable_Tooltip}" />
                    <TextBlock
                        Grid.Row="5" Grid.Column="4"
                        Margin="10,5,5,5"
                        VerticalAlignment="Center">
                        <Run Text="Valid Until: " /><Run Text="{Binding JWSTVectorTableValidUntil, Mode=OneWay, Converter={StaticResource O_DateTimeMinToNeverConverter}}" />
                    </TextBlock>
                </Grid>
            </GroupBox>

            <!-- Search Bar -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    Name="PART_SearchObjectTypeEnumList"
                    Grid.Row="0" Grid.Column="0"
                    MinWidth="80"
                    Margin="10,5,0,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding Source={util:EnumBindingSource {x:Type enums:SearchObjectTypeEnum}}}"
                    SelectedItem="{Binding SearchObjectType}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource O_EnumStaticDescriptionValueConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border
                    Grid.Row="0" Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource ShowSolarSystemBody}">
                    <ComboBox
                        MinWidth="80"
                        Margin="10,5,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding Source={util:EnumBindingSource {x:Type enums:SolarSystemBody}}}"
                        SelectedItem="{Binding SelectedSolarSystemBody}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource O_EnumStaticDescriptionValueConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>
                <Border
                    Grid.Row="0" Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource ShowOrbital}">
                    <ninactrl:AutoCompleteBox
                        Margin="10,5,0,5"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Foreground="{StaticResource PrimaryBrush}"
                        HintText="{Binding Text, Source={StaticResource SelectedObjectName_Hint}}"
                        PopupBackground="{StaticResource TertiaryBackgroundBrush}"
                        SearchResult="{Binding OrbitalSearchVM.TargetSearchResult.Result}"
                        SelectedSearchResult="{Binding OrbitalSearchVM.SelectedTargetSearchResult, Mode=TwoWay}"
                        ShowPopup="{Binding OrbitalSearchVM.ShowPopup, Mode=TwoWay}"
                        Text="{Binding OrbitalSearchVM.TargetName, UpdateSourceTrigger=PropertyChanged}">
                        <ninactrl:AutoCompleteBox.Background>
                            <SolidColorBrush Opacity="0.05" Color="{Binding Color, Source={StaticResource PrimaryBrush}}" />
                        </ninactrl:AutoCompleteBox.Background>
                    </ninactrl:AutoCompleteBox>
                </Border>
                <Border
                    Grid.Row="0" Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource ShowManualTLE}">
                    <TextBox
                        Margin="10,5,0,5"
                        Height="60"
                        MinWidth="400"
                        AcceptsReturn="True"
                        MaxLines="3"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <Binding Path="ManualTLEInput" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <orules:ValidTLERule />
                            </Binding.ValidationRules>
                        </Binding>
                        <TextBox.Background>
                            <SolidColorBrush Opacity="0.05" Color="{Binding Color, Source={StaticResource PrimaryBrush}}" />
                        </TextBox.Background>
                    </TextBox>
                </Border>
                <Button
                    Grid.Row="0" Grid.Column="2"
                    Margin="10,5,0,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding LoadSelectionCommand}">
                    <TextBlock
                        Margin="10,5,10,5"
                        Foreground="{StaticResource ButtonForegroundBrush}"
                        Text="Load"
                        TextWrapping="Wrap" />
                </Button>
            </Grid>

            <!-- Orbital Refresh -->
            <Border
                Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Visibility="{Binding SelectedOrbitalsObject, Converter={StaticResource NullToVisibilityCollapsedConverter}}">
                <UniformGrid Columns="2">
                    <UniformGrid
                        Margin="10,5,0,5"
                        VerticalAlignment="Center"
                        Columns="2">
                        <TextBlock
                            Text="Auto-Refresh"
                            VerticalAlignment="Center" />
                        <CheckBox
                            MinWidth="80"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Unchecked="RefreshEnabled_Toggled"
                            Checked="RefreshEnabled_Toggled"
                            IsEnabled="True"
                            IsChecked="{Binding RefreshEnabled, Mode=OneWay}" />
                    </UniformGrid>
                </UniformGrid>
            </Border>

            <!-- Altitude Chart -->
            <Border
                Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                Visibility="{Binding SelectedOrbitalsObject, Converter={StaticResource NullToVisibilityCollapsedConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7"
                        Margin="5,20,5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="DemiBold">
                            <Run Text="{Binding SelectedOrbitalsObject.Name, Mode=OneWay}" />
                        </TextBlock>
                        <!-- Source and epoch together answer "can I trust this pointing
                             tonight"; either alone does not. -->
                        <Border
                            Margin="8,0,0,0"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Background="{StaticResource TertiaryBackgroundBrush}"
                            BorderBrush="Transparent"
                            CornerRadius="3"
                            ToolTip="{StaticResource ElementSource_Tooltip}"
                            Visibility="{Binding SelectedOrbitalElementsObject.HasSource, Converter={StaticResource BooleanToVisibilityCollapsedConverter}, FallbackValue=Collapsed}">
                            <TextBlock FontSize="11" Opacity="0.75">
                                <Run Text="{Binding SelectedOrbitalElementsObject.SourceDisplay, Mode=OneWay}" /><Run Text=" - epoch " /><Run Text="{Binding SelectedOrbitalElementsObject.EpochDisplay, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <alt:AltitudeChart
                        Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7"
                        MinWidth="400"
                        MinHeight="200"
                        Margin="5,5,5,15"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AnnotateAltitudeAxis="False"
                        DataContext="{Binding SelectedOrbitalsObject}"
                        NighttimeData="{Binding Source={StaticResource nighttimeProxy}, Path=Data}" />
                    <TextBlock
                        Grid.Row="2" Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="RA"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="2" Grid.Column="2"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="{Binding TargetCoordinates.RAString, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="3" Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Dec"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="3" Grid.Column="2"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="{Binding TargetCoordinates.DecString, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="2" Grid.Column="4"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="RA Shift Rate"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="2" Grid.Column="5"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding ShiftTrackingRate.RASecondsPerSiderealSecond, StringFormat=\{0:0.####\}, Mode=OneWay}" /> <Run Text="sec/sidereal sec" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="3" Grid.Column="4"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Dec Shift Rate"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="3" Grid.Column="5"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding ShiftTrackingRate.DecArcsecsPerSec, StringFormat=\{0:0.####\}, Mode=OneWay}" /> <Run Text="arcsec/sec" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="4" Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Distance"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="4" Grid.Column="2"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding Distance.DisplayDistance, StringFormat=\{0:0.####\}, Mode=OneWay}" /> <Run Text="{Binding Distance.DisplayUnits, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="4" Grid.Column="4"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Offset RA"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="4" Grid.Column="5"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="{Binding RAOffset, Converter={StaticResource HoursToHMSConverter}}">
                    </TextBlock>
                    <TextBlock
                        Grid.Row="5" Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Max Exposure"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="5" Grid.Column="2"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding MaxExposureSeconds, StringFormat=\{0:0.###\}, Mode=OneWay}" /> <Run Text="sec" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="5" Grid.Column="4"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Offset Dec"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="5" Grid.Column="5"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="{Binding DecOffset, Converter={StaticResource DegreesToDMSConverter}}">
                    </TextBlock>
                    <WrapPanel
                        Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="7"
                        Orientation="Horizontal"
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <WrapPanel
                            Orientation="Vertical">
                            <Button
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding SendToFramingWizardCommand}">
                                <TextBlock
                                    Margin="10,5,10,5"
                                    Foreground="{StaticResource ButtonForegroundBrush}"
                                    Text="Frame" />
                            </Button>
                            <ninactrl:CancellableButton
                                Margin="5"
                                Padding="10,5,10,5"
                                CancelButtonImage="{StaticResource CancelSVG}"
                                CancelCommand="{Binding CancelSlewAndTrackCommand}"
                                CancelToolTip="{ns:Loc LblCancel}"
                                ButtonText="Slew and Track"
                                Command="{Binding SlewAndTrackCommand}" />
                        </WrapPanel>
                        <WrapPanel
                            Orientation="Vertical">
                            <Button
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding SetTrackingRateCommand}">
                                <TextBlock
                                    Margin="10,5,10,5"
                                    Foreground="{StaticResource ButtonForegroundBrush}"
                                    Text="Set Tracking Rate" />
                            </Button>
                            <Button
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding SetGuiderShiftCommand}">
                                <TextBlock
                                    Margin="10,5,10,5"
                                    Foreground="{StaticResource ButtonForegroundBrush}"
                                    Text="Set Guider Shift Rate" />
                            </Button>
                        </WrapPanel>

                        <WrapPanel
                            Orientation="Vertical">
                            <Button
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding SetOffsetCommand}">
                                <TextBlock
                                    Margin="10,5,10,5"
                                    Foreground="{StaticResource ButtonForegroundBrush}"
                                    Text="Set Offset" />
                            </Button>
                            <Button
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding ResetOffsetCommand}">
                                <TextBlock
                                    Margin="10,5,10,5"
                                    Foreground="{StaticResource ButtonForegroundBrush}"
                                    Text="Clear Offset" />
                            </Button>
                        </WrapPanel>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Properties Grid -->
            <Border
                Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                Visibility="{Binding SelectedOrbitalElementsObject, Converter={StaticResource NullToVisibilityCollapsedConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Long-form provenance. The pill by the object name is the glance;
                         this row is the record, including how the feed was obtained. -->
                    <TextBlock
                        Grid.Row="8" Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Source"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="8" Grid.Column="2"
                        Margin="5"
                        VerticalAlignment="Center"
                        ToolTip="{StaticResource ElementSource_Tooltip}"
                        Text="{Binding SelectedOrbitalElementsObject.SourceDisplay, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="0" Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Epoch"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="0" Grid.Column="2"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="{Binding SelectedOrbitalElementsObject.OrbitalElements.Epoch_jd, Mode=OneWay, Converter={StaticResource O_JulianToDateTimeConverter}}" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Epoch (Julian)"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="2"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="{Binding SelectedOrbitalElementsObject.OrbitalElements.Epoch_jd, StringFormat=\{0:0.####\}, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="2" Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Perihelion Distance"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="2" Grid.Column="2"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding  SelectedOrbitalElementsObject.OrbitalElements.q_Perihelion_au, StringFormat=\{0:0.####\}, Mode=OneWay}" /> <Run Text="au" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="3" Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Eccentricity"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="3" Grid.Column="2"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="{Binding SelectedOrbitalElementsObject.OrbitalElements.e_Eccentricity, StringFormat=\{0:0.####\}, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="4" Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Inclination"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="4" Grid.Column="2"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding SelectedOrbitalElementsObject.OrbitalElements.i_Inclination_rad, StringFormat=\{0:0.####\}, Converter={StaticResource O_RadianToDegreeConverter}, Mode=OneWay}" /><Run Text="°" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="5" Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Arg of Perihelion"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="5" Grid.Column="2"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding SelectedOrbitalElementsObject.OrbitalElements.w_ArgOfPerihelion_rad, StringFormat=\{0:0.####\}, Converter={StaticResource O_RadianToDegreeConverter}, Mode=OneWay}" /><Run Text="°" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="6" Grid.Column="1"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Longitude of Ascending Node"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="6" Grid.Column="2"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding SelectedOrbitalElementsObject.OrbitalElements.node_LongitudeOfAscending_rad, StringFormat=\{0:0.####\}, Converter={StaticResource O_RadianToDegreeConverter}, Mode=OneWay}" /><Run Text="°" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="0" Grid.Column="4"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Periapsis"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="0" Grid.Column="5"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="{Binding SelectedOrbitalElementsObject.OrbitalElements.tp_PeriapsisTime_jd, Mode=OneWay, Converter={StaticResource O_JulianToDateTimeConverter}}" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="4"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Periapsis (Julian)"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="5"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="{Binding SelectedOrbitalElementsObject.OrbitalElements.tp_PeriapsisTime_jd, StringFormat=\{0:0.####\}, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="2" Grid.Column="4"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Mean Anomaly at Epoch"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="2" Grid.Column="5"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding SelectedOrbitalElementsObject.OrbitalElements.M_MeanAnomalyAtEpoch, StringFormat=\{0:0.####\}, Converter={StaticResource O_RadianToDegreeConverter}, Mode=OneWay}" /><Run Text="°" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="3" Grid.Column="4"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Semi-Major Axis"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="3" Grid.Column="5"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding SelectedOrbitalElementsObject.OrbitalElements.a_SemiMajorAxis_au, StringFormat=\{0:0.####\}, Mode=OneWay}" /> <Run Text="au" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="4" Grid.Column="4"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Mean Anomaly"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="4" Grid.Column="5"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding SelectedOrbitalPosition.M_MeanAnomaly_rad, StringFormat=\{0:0.####\}, Converter={StaticResource O_RadianToDegreeConverter}, Mode=OneWay}" /><Run Text="°" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="5" Grid.Column="4"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Eccentric Anomaly"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="5" Grid.Column="5"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding SelectedOrbitalPosition.e_EccentricAnomaly_rad, StringFormat=\{0:0.####\}, Converter={StaticResource O_RadianToDegreeConverter}, Mode=OneWay}" /><Run Text="°" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="6" Grid.Column="4"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="True Anomaly"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="6" Grid.Column="5"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding SelectedOrbitalPosition.v0_TrueAnomaly_rad, StringFormat=\{0:0.####\}, Converter={StaticResource O_RadianToDegreeConverter}, Mode=OneWay}" /><Run Text="°" />
                    </TextBlock>
                    <TextBlock
                        Grid.Row="7" Grid.Column="4"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Distance"
                        FontWeight="DemiBold" />
                    <TextBlock
                        Grid.Row="7" Grid.Column="5"
                        Margin="5"
                        VerticalAlignment="Center">
                        <Run Text="{Binding SelectedOrbitalPosition.Distance.DisplayDistance, StringFormat=\{0:0.####\}, Mode=OneWay}" /> <Run Text="{Binding SelectedOrbitalPosition.Distance.DisplayUnits, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>